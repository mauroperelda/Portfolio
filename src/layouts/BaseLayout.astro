---
/**
 * BaseLayout — outermost shell.
 * Sets <html lang>, theme bootstrap inline script (anti-FOUC),
 * and SEO meta tags. Includes global stylesheet.
 */
import SEO from '../components/layout/SEO.astro';
import type { Lang } from '../i18n/languages';
import { getLanguage } from '../i18n/languages';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  pathname: string;
  ogImage?: string;
  type?: 'website' | 'article' | 'profile';
}

const { title, description, lang, pathname, ogImage, type } = Astro.props;

const language = getLanguage(lang);
---

<!doctype html>
<html lang={language.htmlLang} dir={language.dir} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" href="/rss.xml" title={title} />

    {/* Theme bootstrap — must run before paint to avoid FOUC */}
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          const prefersDark =
            window.matchMedia &&
            window.matchMedia('(prefers-color-scheme: dark)').matches;
          const theme = stored || (prefersDark ? 'dark' : 'light');
          document.documentElement.dataset.theme = theme;
        } catch (_) {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>

    {/* Lang bootstrap — apply stored lang to <html lang> if different */}
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('lang');
          if (stored === 'es' || stored === 'en') {
            document.documentElement.lang =
              stored === 'es' ? 'es-AR' : 'en-US';
          }
        } catch (_) {
          /* localStorage unavailable */
        }
      })();
    </script>

    <SEO
      title={title}
      description={description}
      lang={lang}
      pathname={pathname}
      ogImage={ogImage}
      type={type}
    />
  </head>
  <body>
    <slot />
  </body>
</html>
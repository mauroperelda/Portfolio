---
/**
 * ExperienceTimeline — vertical timeline of all experience entries for the locale.
 */
import { getCollection } from 'astro:content';
import { useTranslations } from '../../i18n/utils';
import { formatPeriod } from '../../utils/format-date';
import Tag from '../ui/Tag.astro';
import type { Lang } from '../../i18n/languages';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const entries = (
  await getCollection('experience', ({ data }) => data.locale === lang)
).sort((a, b) => a.data.order - b.data.order);
---

<section class="relative pl-7">
  {/* Vertical line */}
  <span
    class="absolute left-2 top-1.5 bottom-1.5 w-0.5 bg-border"
    aria-hidden="true"
  ></span>

  <ol class="flex flex-col gap-7">
    {entries.map((entry) => {
      const period = formatPeriod(
        entry.data.period.from,
        entry.data.period.to,
        lang,
      );
      const mode = entry.data.remote
        ? t('experience.mode.remote')
        : t('experience.mode.onsite');
      return (
        <li class="relative">
          {/* Dot */}
          <span
            class="absolute -left-[24px] top-1.5 h-3 w-3 rounded-full border-[3px] border-bg bg-accent"
            aria-hidden="true"
          ></span>

          <div class="mb-1 text-[12px] font-semibold text-accent">
            {period} · {mode}
          </div>
          <h3 class="mb-0.5 text-[16px] font-semibold text-fg">
            {entry.data.role}
          </h3>
          <div class="mb-2.5 text-[13px] text-fg-muted">
            {entry.data.company} — {entry.data.location}
          </div>

          <p class="mb-2.5 text-[14px] text-fg">{entry.data.summary}</p>

          {entry.data.highlights.length > 0 && (
            <ul class="mb-3 list-disc pl-[18px] text-[13.5px] leading-[1.55] text-fg-muted">
              {entry.data.highlights.map((h) => <li class="mb-1">{h}</li>)}
            </ul>
          )}

          {entry.data.stack.length > 0 && (
            <div class="flex flex-wrap gap-1.5">
              {entry.data.stack.map((s) => <Tag>{s}</Tag>)}
            </div>
          )}

          {entry.body && entry.body.trim().length > 0 && (
            <div class="prose-body mt-2.5">
              <Fragment set:html={entry.body.replace(/\n/g, '<br/>')} />
            </div>
          )}
        </li>
      );
    })}
  </ol>
</section>
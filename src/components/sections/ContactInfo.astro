---
/**
 * ContactInfo — email, LinkedIn, GitHub cards + helpful note.
 */
import { useTranslations } from '../../i18n/utils';
import { AUTHOR, SOCIAL } from '../../config/site';
import type { Lang } from '../../i18n/languages';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="flex flex-col gap-3.5">
  <div class="rounded-xl border border-border bg-bg-elev px-5 py-[18px]">
    <div class="text-[12px] uppercase tracking-wider text-fg-dim">
      {t('contact.section.email')}
    </div>
    <a
      href={SOCIAL.email}
      class="mt-1.5 inline-block text-[14px] font-medium text-accent transition-opacity hover:opacity-80"
    >
      {AUTHOR.email}
    </a>
  </div>
  <div class="rounded-xl border border-border bg-bg-elev px-5 py-[18px]">
    <div class="text-[12px] uppercase tracking-wider text-fg-dim">
      {t('contact.section.linkedin')}
    </div>
    <a
      href={SOCIAL.linkedin}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-1.5 inline-block text-[14px] font-medium text-accent transition-opacity hover:opacity-80"
    >
      linkedin.com/in/mauro-perelda
    </a>
  </div>
  <div class="rounded-xl border border-border bg-bg-elev px-5 py-[18px]">
    <div class="text-[12px] uppercase tracking-wider text-fg-dim">
      {t('contact.section.github')}
    </div>
    <a
      href={SOCIAL.github}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-1.5 inline-block text-[14px] font-medium text-accent transition-opacity hover:opacity-80"
    >
      github.com/mauroperelda
    </a>
  </div>
  <p class="text-[13px] text-fg-muted">{t('contact.note')}</p>
</section>
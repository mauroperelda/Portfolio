---
/**
 * SEO meta tags + hreflang + JSON-LD.
 * Pure server-rendered meta; no client JS.
 */
import { getHreflangs } from '../../i18n/utils';
import { AUTHOR, SITE_URL, SITE_NAME } from '../../config/site';
import type { Lang } from '../../i18n/languages';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  pathname: string; // e.g. /es/projects/odontosoft
  ogImage?: string;
  type?: 'website' | 'article' | 'profile';
  publishedTime?: string;
}

const { title, description, lang, pathname, ogImage, type = 'website', publishedTime } = Astro.props;

const canonical = new URL(pathname, SITE_URL).toString();
const ogImg = ogImage ?? '/og-image-default.png';
const ogImgAbs = new URL(ogImg, SITE_URL).toString();

const ogLocale = lang === 'es' ? 'es_AR' : 'en_US';

// hreflang for all supported languages + x-default
const hreflangs = getHreflangs(pathname.replace(/^\/(es|en)/, '') || '/');

// JSON-LD Person schema (only on home page is most accurate, but harmless everywhere)
const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: AUTHOR.name,
  jobTitle: AUTHOR.role[lang],
  url: SITE_URL,
  email: AUTHOR.email,
  address: {
    '@type': 'PostalAddress',
    addressLocality: AUTHOR.location.city,
    addressRegion: AUTHOR.location.province,
    addressCountry: AUTHOR.location.country,
  },
  sameAs: [
    'https://linkedin.com/in/mauro-perelda-386603199',
    'https://github.com/mauroperelda',
  ],
};

const ogLocaleAlt = lang === 'es' ? 'en_US' : 'es_AR';
---

<title>{title} · {SITE_NAME}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="generator" content={Astro.generator} />

<!-- hreflang alternates -->
{hreflangs.map(({ lang: hl, href }) => (
  <link rel="alternate" hreflang={hl} href={href} />
))}
<link rel="alternate" hreflang={ogLocale} href={canonical} />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImgAbs} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={ogLocale} />
<meta property="og:locale:alternate" content={ogLocaleAlt} />
<meta property="og:site_name" content={SITE_NAME} />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImgAbs} />

<!-- Theme color (dark by default, overridden by inline script) -->
<meta name="theme-color" content="#16171d" media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content="#f0f2f5" media="(prefers-color-scheme: light)" />

<!-- JSON-LD Person -->
<script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
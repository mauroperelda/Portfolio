---
/**
 * Sidebar — desktop sticky navigation (md+).
 * Hidden on mobile; mobile drawer lives in MobileMenu island.
 */
import { useTranslations, localizedPath } from '../../i18n/utils';
import type { Lang } from '../../i18n/languages';

interface Props {
  lang: Lang;
  pathname: string;
}

const { lang, pathname } = Astro.props;
const t = useTranslations(lang);

interface Item {
  key:
    | 'nav.home'
    | 'nav.experience'
    | 'nav.projects'
    | 'nav.stack'
    | 'nav.contact';
  href: string;
}

const navItems: Item[] = [
  { key: 'nav.home', href: localizedPath(lang, '/') },
  { key: 'nav.experience', href: localizedPath(lang, '/experience') },
  { key: 'nav.projects', href: localizedPath(lang, '/projects') },
  { key: 'nav.stack', href: localizedPath(lang, '/stack') },
  { key: 'nav.contact', href: localizedPath(lang, '/contact') },
];

function isActive(href: string): boolean {
  // Strip trailing slash for comparison; mark active when pathname matches
  // or starts with the href's path (for sub-pages like /projects/odontosoft).
  const normalized = pathname.replace(/\/$/, '');
  const candidate = href.replace(/\/$/, '');
  if (candidate === `/${lang}`) return normalized === candidate;
  return normalized === candidate || normalized.startsWith(candidate + '/');
}

const ICONS: Record<Item['key'], string> = {
  'nav.home': 'M3 9 12 2l9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z M9 22V12h6v10',
  'nav.experience': 'M2 7h20v14H2z M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16',
  'nav.projects': 'M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z',
  'nav.stack': 'M12 2 2 7l10 5 10-5-10-5z M2 17l10 5 10-5 M2 12l10 5 10-5',
  'nav.contact': 'M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z M22 6 12 13 2 6',
};
---

<aside class="sticky top-0 hidden h-screen w-60 shrink-0 flex-col bg-sidebar-bg text-white md:flex">
  <div class="flex items-center gap-2.5 border-b border-border-light px-5 py-5">
    <div
      class="flex h-[38px] w-[38px] items-center justify-center rounded-[10px] text-sm font-bold text-white"
      style="background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);"
      aria-hidden="true"
    >
      MP
    </div>
    <div>
      <div class="text-sm font-semibold">Mauro Perelda</div>
      <div class="text-[11px] text-sidebar-fg">Full Stack .NET</div>
    </div>
  </div>

  <div class="px-5 pt-[18px] pb-1.5 text-[10px] font-bold uppercase tracking-widest text-sidebar-section">
    {t('nav.section.navigate')}
  </div>
  <nav class="flex flex-col">
    {navItems.slice(0, 4).map((item) => {
      const active = isActive(item.href);
      return (
        <a
          href={item.href}
          class:list={[
            'flex items-center gap-2.5 px-5 py-2.5 text-[13.5px] transition-colors',
            active
              ? 'bg-sidebar-active text-sidebar-fg-active'
              : 'text-sidebar-fg hover:bg-sidebar-hover hover:text-white',
          ]}
          aria-current={active ? 'page' : undefined}
        >
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class:list={[active ? 'opacity-100' : 'opacity-70']} aria-hidden="true">
            <path d={ICONS[item.key]} />
          </svg>
          {t(item.key)}
        </a>
      );
    })}
  </nav>

  <div class="px-5 pt-[18px] pb-1.5 text-[10px] font-bold uppercase tracking-widest text-sidebar-section">
    {t('nav.section.connect')}
  </div>
  <nav class="flex flex-col">
    {navItems.slice(4).map((item) => {
      const active = isActive(item.href);
      return (
        <a
          href={item.href}
          class:list={[
            'flex items-center gap-2.5 px-5 py-2.5 text-[13.5px] transition-colors',
            active
              ? 'bg-sidebar-active text-sidebar-fg-active'
              : 'text-sidebar-fg hover:bg-sidebar-hover hover:text-white',
          ]}
          aria-current={active ? 'page' : undefined}
        >
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class:list={[active ? 'opacity-100' : 'opacity-70']} aria-hidden="true">
            <path d={ICONS[item.key]} />
          </svg>
          {t(item.key)}
        </a>
      );
    })}
  </nav>
</aside>
---
/**
 * Breadcrumb — derived from the current pathname.
 * Renders: home › projects › odontosoft (last segment in bold).
 */
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/languages';

interface Props {
  lang: Lang;
  pathname: string;
}

const { lang, pathname } = Astro.props;
const t = useTranslations(lang);

// Map known slug → i18n label
const SLUG_LABELS: Record<string, string> = {
  projects: t('bc.projects'),
  odontosoft: t('bc.odontosoft'),
};

const segments = pathname.split('/').filter(Boolean);
// Drop the leading locale segment
if (segments[0] === 'es' || segments[0] === 'en') segments.shift();

const crumbs = segments.map((seg, idx) => {
  const path = '/' + ['es', ...segments.slice(0, idx + 1)].join('/');
  const isLast = idx === segments.length - 1;
  const label = SLUG_LABELS[seg] ?? seg;
  return { path, label, isLast };
});
---

<nav aria-label="Breadcrumb" class="text-[13px] text-fg-dim">
  <ol class="flex flex-wrap items-center gap-1.5">
    {crumbs.map((c, i) => (
      <li class="flex items-center gap-1.5">
        {i > 0 && <span aria-hidden="true" class="text-fg-dim">›</span>}
        {c.isLast ? (
          <span class="font-semibold text-fg">{c.label}</span>
        ) : (
          <a href={c.path} class="transition-colors hover:text-fg">{c.label}</a>
        )}
      </li>
    ))}
  </ol>
</nav>
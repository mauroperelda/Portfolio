---
/**
 * Topbar — sticky header with breadcrumb, mobile menu trigger,
 * language switcher, theme toggle, and Contact CTA.
 */
import Breadcrumb from './Breadcrumb.astro';
import ThemeToggle from '../../islands/ThemeToggle.tsx';
import LangSwitcher from '../../islands/LangSwitcher.tsx';
import MobileMenu from '../../islands/MobileMenu.tsx';
import { useTranslations, getPathWithoutLocale, localizedPath } from '../../i18n/utils';
import type { Lang } from '../../i18n/languages';

interface Props {
  lang: Lang;
  pathname: string;
}

const { lang, pathname } = Astro.props;
const t = useTranslations(lang);

const pathWithoutLocale = getPathWithoutLocale(new URL(pathname, 'http://x'));

interface NavKey {
  key:
    | 'nav.home'
    | 'nav.experience'
    | 'nav.projects'
    | 'nav.stack'
    | 'nav.contact';
  href: string;
}

const navItems: ReadonlyArray<NavKey> = [
  { key: 'nav.home', href: localizedPath(lang, '/') },
  { key: 'nav.experience', href: localizedPath(lang, '/experience') },
  { key: 'nav.projects', href: localizedPath(lang, '/projects') },
  { key: 'nav.stack', href: localizedPath(lang, '/stack') },
  { key: 'nav.contact', href: localizedPath(lang, '/contact') },
];
---

<header
  class="sticky top-0 z-30 flex h-14 items-center gap-3 border-b border-border bg-bg-elev px-5"
>
  <MobileMenu
    client:load
    items={navItems}
    brandName="Mauro Perelda"
    brandTitle="Full Stack .NET"
    openLabel={t('topbar.menu')}
    closeLabel={t('topbar.close')}
    sectionNavigateLabel={t('nav.section.navigate')}
    sectionConnectLabel={t('nav.section.connect')}
  />

  <Breadcrumb lang={lang} pathname={pathname} />

  <div class="flex-1"></div>

  <LangSwitcher
    client:load
    current={lang}
    pathWithoutLocale={pathWithoutLocale}
    label={t('topbar.lang.toggle')}
  />
  <ThemeToggle client:load />

  <a
    href={localizedPath(lang, '/contact')}
    class="hidden h-9 items-center rounded-lg bg-accent-strong px-3.5 text-[13px] font-semibold text-white transition-opacity hover:opacity-90 sm:inline-flex"
  >
    {t('topbar.contact.cta')}
  </a>
</header>
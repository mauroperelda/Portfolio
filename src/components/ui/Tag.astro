---
/**
 * Tag — small inline pill for tech stack items, project labels, etc.
 * Default variant = accent (indigo). Pass `variant="solid"` for filled style.
 */
interface Props {
  variant?: 'accent' | 'solid' | 'muted';
  size?: 'sm' | 'md';
  href?: string;
}

const { variant = 'accent', size = 'sm', href } = Astro.props;

const sizeClass = size === 'md' ? 'text-[13px] px-2.5 py-1' : 'text-[12px] px-2.5 py-1';
const variantClass =
  variant === 'solid'
    ? 'bg-accent-strong text-white border-transparent'
    : variant === 'muted'
    ? 'bg-bg-hover text-fg-muted border-border'
    : 'bg-accent-soft text-accent border-accent-border';
const baseClass = `inline-flex items-center rounded-md border font-medium transition-colors ${sizeClass} ${variantClass}`;

const Tag = href ? 'a' : 'span';
---

<Tag class={baseClass} href={href}>
  <slot />
</Tag>
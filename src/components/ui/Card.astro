---
/**
 * Card — base elevated surface with border.
 * If `href` is provided, wraps content in an <a>; otherwise a <div>.
 */
interface Props {
  href?: string;
  class?: string;
  interactive?: boolean;
}

const { href, class: extraClass = '', interactive = false } = Astro.props;

const baseClass =
  'rounded-xl border border-border bg-bg-elev overflow-hidden ' +
  (interactive
    ? 'transition-transform duration-150 hover:-translate-y-0.5 hover:border-accent'
    : '');

const Tag = href ? 'a' : 'div';
---

<Tag class={`${baseClass} ${extraClass}`} href={href}>
  <slot />
</Tag>
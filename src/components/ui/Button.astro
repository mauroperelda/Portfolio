---
/**
 * Button — primary CTA, ghost, or link style.
 * Renders an <a> if `href` is provided, otherwise a <button>.
 */
type Variant = 'primary' | 'ghost' | 'link';
type Size = 'sm' | 'md' | 'lg';

interface Props {
  href?: string;
  variant?: Variant;
  size?: Size;
  type?: 'button' | 'submit';
  class?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  type = 'button',
  class: extraClass = '',
} = Astro.props;

const sizeClass =
  size === 'lg'
    ? 'h-11 px-5 text-sm'
    : size === 'sm'
    ? 'h-8 px-3 text-[12.5px]'
    : 'h-10 px-4 text-[13.5px]';

const variantClass =
  variant === 'primary'
    ? 'bg-accent-strong text-white hover:opacity-90'
    : variant === 'ghost'
    ? 'border border-border bg-transparent text-fg hover:bg-bg-hover'
    : 'bg-transparent text-fg underline-offset-4 hover:underline';

const baseClass =
  `inline-flex items-center justify-center gap-2 rounded-lg font-semibold transition-all ${sizeClass} ${variantClass} ${extraClass}`;

const Tag = href ? 'a' : 'button';
---

<Tag class={baseClass} href={href} type={!href ? type : undefined}>
  <slot />
</Tag>
---
import PageLayout from '../../layouts/PageLayout.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import ExperienceTimeline from '../../components/sections/ExperienceTimeline.astro';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('es');
---

<PageLayout
  title={t('experience.title')}
  description="5 años construyendo productos .NET en equipos remotos bajo Scrum."
  lang="es"
>
  <SectionHeading title={t('experience.title')} subtitle={t('experience.subtitle')} />
  <ExperienceTimeline lang="es" />
</PageLayout>
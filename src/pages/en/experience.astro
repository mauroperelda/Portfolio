---
import PageLayout from '../../layouts/PageLayout.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import ExperienceTimeline from '../../components/sections/ExperienceTimeline.astro';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('en');
---

<PageLayout
  title={t('experience.title')}
  description="5 years building .NET products on remote teams under Scrum."
  lang="en"
>
  <SectionHeading title={t('experience.title')} subtitle={t('experience.subtitle')} />
  <ExperienceTimeline lang="en" />
</PageLayout>